generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// OFFLINE SYNC
// ============================================================

// Generic idempotency store. The frontend attaches an `Idempotency-Key`
// header (a client-generated UUID, persisted in its local offline queue)
// to every mutating request. If a request with the same key is replayed
// (e.g. after reconnecting from offline, or a retried request whose
// response never reached the client), we return the original response
// instead of executing the write twice. Keyed on method+path+key so the
// same key can't accidentally collide across unrelated endpoints.
model IdempotencyKey {
  id         String   @id @default(uuid())
  key        String
  method     String
  path       String
  statusCode Int
  response   Json
  createdAt  DateTime @default(now())

  @@unique([key, method, path])
  @@index([createdAt])
  @@map("idempotency_keys")
}

// Every successful mutating request the LOCAL/offline app handles gets
// logged here — never written to on Render (there's nothing local to
// push from there). The sync job in the local app's bootstrap-local.ts
// replays these against Render in createdAt order, reusing the same
// idempotencyKey as the header value, so a request that gets pushed
// twice for any reason is a no-op on Render rather than a duplicate.
model SyncOutbox {
  id             String    @id // = the request's own Idempotency-Key
  method         String
  path           String
  body           Json
  createdAt      DateTime  @default(now())
  pushedAt       DateTime?
  lastError      String?

  @@index([pushedAt])
  @@map("sync_outbox")
}

// ============================================================
// ENUMS
// ============================================================

enum RoleName {
  ADMIN
  MANAGER
  CASHIER
  BARTENDER
  STOREKEEPER
  // Read-only account for the owner's login on Render — blocked from
  // every mutating request by RolesGuard regardless of route.
  VIEWER
  // Non-human account the local/offline app's sync job authenticates as
  // when pushing queued changes up to Render. Never used by a person.
  SYNC_DEVICE
}

enum PriceType {
  NORMAL
  WHOLESALE
  HAPPY_HOUR
  SPECIAL
}

enum PurchasePaymentStatus {
  PAID
  PARTIAL
  CREDIT
}

enum InventoryTransactionType {
  PURCHASE
  SALE
  RETURN
  WASTAGE
  DAMAGE
  ADJUSTMENT
  TRANSFER_IN
  TRANSFER_OUT
}

enum ReferenceType {
  PURCHASE
  SALE
  STOCK_ADJUSTMENT
  WASTAGE
  MANUAL
}

enum StockAdjustmentReason {
  COUNT_CORRECTION
  UNRECORDED_STOCK
  LOST
  FOUND
  OTHER
}

enum WastageReason {
  BROKEN
  SPOILED
  SPILLED
  EXPIRED
  STAFF_CONSUMPTION
  OTHER
}

enum SaleStatus {
  COMPLETED
  VOIDED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentMethod {
  CASH
  AIRTEL_MONEY
  MPAMBA
  BANK
  CREDIT
  OTHER
}

enum CashSessionStatus {
  OPEN
  CLOSED
}

enum CashTransactionType {
  OPENING_BALANCE
  SALE
  EXPENSE
  WITHDRAWAL
  DEPOSIT
  REFUND
  ADJUSTMENT
}

enum CustomerTransactionType {
  CREDIT_SALE
  PAYMENT
  ADJUSTMENT
}

enum SupplierTransactionType {
  PURCHASE
  PAYMENT
  ADJUSTMENT
}

// ============================================================
// USERS & ROLES
// ============================================================

model Role {
  id          String   @id @default(uuid())
  name        RoleName @unique
  description String?
  users       User[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("roles")
}

model User {
  id           String   @id @default(uuid())
  name         String
  username     String   @unique
  email        String?  @unique
  passwordHash String
  roleId       String
  role         Role     @relation(fields: [roleId], references: [id])
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sales              Sale[]
  purchasesCreated   Purchase[]
  cashSessions       CashSession[]
  expensesCreated    Expense[]
  auditLogs          AuditLog[]
  inventoryTxns      InventoryTransaction[]
  stockAdjustments   StockAdjustment[]        @relation("adjustment_created_by")
  approvedAdjustments StockAdjustment[]       @relation("adjustment_approved_by")
  wastageRecorded    Wastage[]                @relation("wastage_recorded_by")
  wastageApproved    Wastage[]                @relation("wastage_approved_by")
  pricesCreated      ProductPrice[]
  emptyBottleTxns    EmptyBottleTransaction[]

  @@map("users")
}

// ============================================================
// PRODUCTS
// ============================================================

model Category {
  id          String    @id @default(uuid())
  name        String    @unique
  description String?
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("categories")
}

model Product {
  id             String   @id @default(uuid())
  categoryId     String?
  category       Category? @relation(fields: [categoryId], references: [id])
  name           String
  sku            String?  @unique
  barcode        String?  @unique
  description    String?
  trackInventory Boolean  @default(true)
  tracksEmptyBottles Boolean @default(false)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  units             ProductUnit[]
  prices            ProductPrice[]
  purchaseItems     PurchaseItem[]
  saleItems         SaleItem[]
  inventoryTxns     InventoryTransaction[]
  stockAdjustments  StockAdjustment[]
  wastage           Wastage[]
  emptyBottleTxns   EmptyBottleTransaction[]

  @@map("products")
}

// A unit belonging to a product. quantityInBaseUnit expresses how many
// "base units" (e.g. bottles/ml) one of this unit equals.
model ProductUnit {
  id                  String   @id @default(uuid())
  productId           String
  product             Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  name                String   // e.g. "Case", "Bottle", "Shot"
  quantityInBaseUnit  Decimal  @db.Decimal(14, 4)
  isPurchaseUnit      Boolean  @default(false)
  isSaleUnit          Boolean  @default(false)
  isBaseUnit          Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  prices          ProductPrice[]
  purchaseItems   PurchaseItem[]
  saleItems       SaleItem[]
  inventoryTxns   InventoryTransaction[]
  wastage         Wastage[]

  @@index([productId])
  @@map("product_units")
}

model ProductPrice {
  id            String     @id @default(uuid())
  productId     String
  product       Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  unitId        String
  unit          ProductUnit @relation(fields: [unitId], references: [id])
  price         Decimal    @db.Decimal(14, 2)
  priceType     PriceType  @default(NORMAL)
  effectiveFrom DateTime   @default(now())
  effectiveTo   DateTime?
  createdById   String?
  createdBy     User?      @relation(fields: [createdById], references: [id])
  createdAt     DateTime   @default(now())

  @@index([productId, unitId, priceType])
  @@map("product_prices")
}

// ============================================================
// SUPPLIERS & PURCHASES
// ============================================================

model Supplier {
  id        String   @id @default(uuid())
  name      String
  phone     String?
  email     String?
  address   String?
  taxNumber String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  purchases           Purchase[]
  supplierTransactions SupplierTransaction[]

  @@map("suppliers")
}

model Purchase {
  id             String                @id @default(uuid())
  supplierId     String?
  supplier       Supplier?             @relation(fields: [supplierId], references: [id])
  invoiceNumber  String?
  purchaseDate   DateTime              @default(now())

  subtotal       Decimal               @db.Decimal(14, 2)
  discount       Decimal               @default(0) @db.Decimal(14, 2)
  tax            Decimal               @default(0) @db.Decimal(14, 2)
  total          Decimal               @db.Decimal(14, 2)

  paymentStatus  PurchasePaymentStatus @default(CREDIT)
  amountPaid     Decimal               @default(0) @db.Decimal(14, 2)
  notes          String?

  createdById    String
  createdBy      User                  @relation(fields: [createdById], references: [id])
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  items                PurchaseItem[]
  inventoryTxns        InventoryTransaction[]
  supplierTransactions SupplierTransaction[]
  cashTransactions     CashTransaction[]

  @@map("purchases")
}

model PurchaseItem {
  id         String      @id @default(uuid())
  purchaseId String
  purchase   Purchase    @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  productId  String
  product    Product     @relation(fields: [productId], references: [id])
  unitId     String
  unit       ProductUnit @relation(fields: [unitId], references: [id])
  quantity   Decimal     @db.Decimal(14, 4)
  unitCost   Decimal     @db.Decimal(14, 2)
  totalCost  Decimal     @db.Decimal(14, 2)

  @@map("purchase_items")
}

model SupplierTransaction {
  id            String                  @id @default(uuid())
  supplierId    String
  supplier      Supplier                @relation(fields: [supplierId], references: [id])
  transactionType SupplierTransactionType
  amount        Decimal                 @db.Decimal(14, 2)
  referenceType ReferenceType?
  referenceId   String?
  purchaseId    String?
  purchase      Purchase?               @relation(fields: [purchaseId], references: [id])
  description   String?
  createdAt     DateTime                @default(now())

  @@map("supplier_transactions")
}

// ============================================================
// INVENTORY
// ============================================================

model InventoryTransaction {
  id              String                    @id @default(uuid())
  productId       String
  product         Product                   @relation(fields: [productId], references: [id])
  unitId          String
  unit            ProductUnit               @relation(fields: [unitId], references: [id])
  transactionType InventoryTransactionType
  // quantity is always stored in the product's BASE unit; positive = stock in, negative = stock out
  quantity        Decimal                   @db.Decimal(14, 4)

  referenceType   ReferenceType?
  referenceId     String?
  purchaseId      String?
  purchase        Purchase?                 @relation(fields: [purchaseId], references: [id])
  saleId          String?
  sale            Sale?                     @relation(fields: [saleId], references: [id])

  unitCost        Decimal?                  @db.Decimal(14, 2)

  createdById     String
  createdBy       User                      @relation(fields: [createdById], references: [id])
  createdAt       DateTime                  @default(now())

  @@index([productId, createdAt])
  @@map("inventory_transactions")
}

model StockAdjustment {
  id               String                  @id @default(uuid())
  productId        String
  product          Product                 @relation(fields: [productId], references: [id])
  systemQuantity   Decimal                 @db.Decimal(14, 4)
  physicalQuantity Decimal                 @db.Decimal(14, 4)
  difference       Decimal                 @db.Decimal(14, 4)
  reason           StockAdjustmentReason
  notes            String?
  approvedById     String?
  approvedBy       User?                   @relation("adjustment_approved_by", fields: [approvedById], references: [id])
  createdById      String
  createdBy        User                    @relation("adjustment_created_by", fields: [createdById], references: [id])
  createdAt        DateTime                @default(now())

  @@map("stock_adjustments")
}

model Wastage {
  id           String        @id @default(uuid())
  productId    String
  product      Product       @relation(fields: [productId], references: [id])
  unitId       String
  unit         ProductUnit   @relation(fields: [unitId], references: [id])
  quantity     Decimal       @db.Decimal(14, 4)
  reason       WastageReason
  description  String?
  recordedById String
  recordedBy   User          @relation("wastage_recorded_by", fields: [recordedById], references: [id])
  approvedById String?
  approvedBy   User?         @relation("wastage_approved_by", fields: [approvedById], references: [id])
  createdAt    DateTime      @default(now())

  @@map("wastage")
}

// ============================================================
// SALES / POS
// ============================================================

model Sale {
  id             String     @id @default(uuid())
  invoiceNumber  String     @unique
  clientSaleId   String?    @unique
  userId         String
  user           User       @relation(fields: [userId], references: [id])
  customerId     String?
  customer       Customer?  @relation(fields: [customerId], references: [id])
  cashSessionId  String?
  cashSession    CashSession? @relation(fields: [cashSessionId], references: [id])
  saleDate       DateTime   @default(now())

  subtotal       Decimal    @db.Decimal(14, 2)
  discount       Decimal    @default(0) @db.Decimal(14, 2)
  tax            Decimal    @default(0) @db.Decimal(14, 2)
  total          Decimal    @db.Decimal(14, 2)

  status         SaleStatus @default(COMPLETED)
  voidReason     String?

  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  items                SaleItem[]
  payments             Payment[]
  inventoryTxns        InventoryTransaction[]
  cashTransactions     CashTransaction[]
  customerTransactions CustomerTransaction[]

  @@map("sales")
}

model SaleItem {
  id         String      @id @default(uuid())
  saleId     String
  sale       Sale        @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId  String
  product    Product     @relation(fields: [productId], references: [id])
  unitId     String
  unit       ProductUnit @relation(fields: [unitId], references: [id])
  quantity   Decimal     @db.Decimal(14, 4)
  unitPrice  Decimal     @db.Decimal(14, 2)
  discount   Decimal     @default(0) @db.Decimal(14, 2)
  total      Decimal     @db.Decimal(14, 2)

  @@map("sale_items")
}

model Payment {
  id            String        @id @default(uuid())
  saleId        String
  sale          Sale          @relation(fields: [saleId], references: [id], onDelete: Cascade)
  paymentMethod PaymentMethod
  amount        Decimal       @db.Decimal(14, 2)
  reference     String?
  // Which customer this specific payment line is credited to. Only set (and
  // required) when paymentMethod = CREDIT. Because a single sale can carry
  // several CREDIT payment lines, this is what lets ONE sale be split across
  // MULTIPLE customers' tabs (e.g. a table splitting a bill) instead of a
  // sale only ever being billable to one customer.
  customerId    String?
  customer      Customer?     @relation(fields: [customerId], references: [id])
  // Optional free-text note shown alongside this payment in the customer's
  // bill/payment history (e.g. "paid half now, rest Friday").
  comment       String?
  paidAt        DateTime      @default(now())
  createdById   String

  @@map("payments")
}

// ============================================================
// CASH
// ============================================================

model CashSession {
  id           String            @id @default(uuid())
  userId       String
  user         User              @relation(fields: [userId], references: [id])
  openedAt     DateTime          @default(now())
  closedAt     DateTime?

  openingCash  Decimal           @db.Decimal(14, 2)
  expectedCash Decimal?          @db.Decimal(14, 2)
  actualCash   Decimal?          @db.Decimal(14, 2)
  difference   Decimal?          @db.Decimal(14, 2)

  status       CashSessionStatus @default(OPEN)

  sales             Sale[]
  cashTransactions  CashTransaction[]

  @@map("cash_sessions")
}

model CashTransaction {
  id              String              @id @default(uuid())
  cashSessionId   String
  cashSession     CashSession         @relation(fields: [cashSessionId], references: [id])
  transactionType CashTransactionType
  amount          Decimal             @db.Decimal(14, 2)

  referenceType   ReferenceType?
  referenceId     String?
  saleId          String?
  sale            Sale?               @relation(fields: [saleId], references: [id])
  purchaseId      String?
  purchase        Purchase?           @relation(fields: [purchaseId], references: [id])
  expenseId       String?
  expense         Expense?            @relation(fields: [expenseId], references: [id])

  description     String?
  createdById     String
  createdAt       DateTime            @default(now())

  @@map("cash_transactions")
}

// ============================================================
// EXPENSES
// ============================================================

model ExpenseCategory {
  id          String    @id @default(uuid())
  name        String    @unique
  description String?
  expenses    Expense[]

  @@map("expense_categories")
}

model Expense {
  id            String          @id @default(uuid())
  categoryId    String
  category      ExpenseCategory @relation(fields: [categoryId], references: [id])
  description   String
  amount        Decimal         @db.Decimal(14, 2)
  paymentMethod PaymentMethod
  reference     String?
  expenseDate   DateTime        @default(now())
  createdById   String
  createdBy     User            @relation(fields: [createdById], references: [id])
  createdAt     DateTime        @default(now())

  cashTransactions CashTransaction[]

  @@map("expenses")
}

// ============================================================
// CUSTOMERS / CREDIT
// ============================================================

model Customer {
  id          String   @id @default(uuid())
  name        String
  phone       String?
  address     String?
  creditLimit Decimal  @default(0) @db.Decimal(14, 2)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  sales                 Sale[]
  customerTransactions  CustomerTransaction[]
  payments              Payment[]

  @@map("customers")
}

model CustomerTransaction {
  id              String                   @id @default(uuid())
  customerId      String
  customer        Customer                 @relation(fields: [customerId], references: [id])
  transactionType CustomerTransactionType
  amount          Decimal                  @db.Decimal(14, 2)
  referenceType   ReferenceType?
  referenceId     String?
  saleId          String?
  sale            Sale?                    @relation(fields: [saleId], references: [id])
  description     String?
  createdAt       DateTime                 @default(now())

  @@map("customer_transactions")
}

enum EmptyBottleTransactionType {
  COLLECTED
  RETURNED_TO_SUPPLIER
  BROKEN
  ADJUSTMENT
}

model EmptyBottleTransaction {
  id              String                     @id @default(uuid())
  productId       String
  product         Product                    @relation(fields: [productId], references: [id])
  transactionType EmptyBottleTransactionType
  // signed: positive = more empties on hand (collected), negative = fewer (returned/broken)
  quantity        Int
  notes           String?
  createdById     String
  createdBy       User                       @relation(fields: [createdById], references: [id])
  createdAt       DateTime                   @default(now())

  @@index([productId, createdAt])
  @@map("empty_bottle_transactions")
}

// ============================================================
// EQUITY / CAPITAL / FIXED ASSETS / CASH BOOK
// (mirrors the bar's manual "capital accounts", "expenditure",
// and "cash"/"banked cash" workbook sheets)
// ============================================================

enum CapitalTransactionType {
  CONTRIBUTION // partner put money/stock into the business
  DRAWING      // partner took money/goods out
}

model Partner {
  id        String   @id @default(uuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  capitalTransactions CapitalTransaction[]

  @@map("partners")
}

model CapitalTransaction {
  id              String                 @id @default(uuid())
  partnerId       String
  partner         Partner                @relation(fields: [partnerId], references: [id])
  transactionType CapitalTransactionType
  description     String
  amount          Decimal                @db.Decimal(14, 2)
  // Matches the extra "capital usage" column in the partners' paper capital
  // account sheet: of the total `amount` a partner put in/took out, how much
  // of it was specifically stock/inventory (as opposed to rent, fuel,
  // fixtures, deposits, etc). Left null when the whole transaction is
  // non-stock, or when the split simply wasn't recorded.
  stockValue      Decimal?               @db.Decimal(14, 2)
  transactionDate DateTime               @default(now())
  createdById     String
  createdAt       DateTime               @default(now())

  @@index([partnerId, transactionDate])
  @@map("capital_transactions")
}

// One-off capital expenditure (furniture, plumbing/renovation, deposits) -
// distinct from day-to-day operating Expense records. Feeds the Balance
// Sheet's Non-Current Assets, not the P&L.
model FixedAsset {
  id           String   @id @default(uuid())
  name         String
  cost         Decimal  @db.Decimal(14, 2)
  acquiredDate DateTime @default(now())
  notes        String?
  createdById  String
  createdAt    DateTime @default(now())

  @@map("fixed_assets")
}

enum CashAccountType {
  BANK
  MOBILE_MONEY
  PETTY_CASH
}

// A company-wide cash/bank account (as opposed to CashSession, which is a
// single cashier's till/shift). Balances are derived from CashAccountTransaction.
model CashAccount {
  id        String          @id @default(uuid())
  name      String          @unique // e.g. "Bank", "Airtel Money", "Petty Cash"
  type      CashAccountType
  isActive  Boolean         @default(true)
  createdAt DateTime        @default(now())

  transactions CashAccountTransaction[]

  @@map("cash_accounts")
}

enum CashAccountTransactionType {
  CAPITAL_IN      // partner contribution landing in this account
  SALE            // cash sales banked/collected into this account
  BILL_PAYMENT    // customer credit payment received into this account
  PURCHASE        // stock purchase paid from this account
  EXPENSE         // operating expense paid from this account
  TRANSFER_IN     // e.g. petty cash banked -> Bank
  TRANSFER_OUT
  ADJUSTMENT
}

model CashAccountTransaction {
  id              String                      @id @default(uuid())
  cashAccountId   String
  cashAccount     CashAccount                 @relation(fields: [cashAccountId], references: [id])
  transactionType CashAccountTransactionType
  // signed: positive = money in, negative = money out
  amount          Decimal                     @db.Decimal(14, 2)
  description     String?
  referenceType   ReferenceType?
  referenceId     String?
  transactionDate DateTime                    @default(now())
  createdById     String
  createdAt       DateTime                    @default(now())

  @@index([cashAccountId, transactionDate])
  @@map("cash_account_transactions")
}

// ============================================================
// AUDIT
// ============================================================

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  action     String
  entityType String
  entityId   String?
  oldValues  Json?
  newValues  Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@map("audit_logs")
}
